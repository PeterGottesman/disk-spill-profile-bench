# Copy to config.env and edit. Every path and budget is a knob so a
# different GPU / RAM / disk machine can replay the same phases.
#
#   cp config.env.example config.env
#   ./scripts/detect-hardware.sh          # prints suggestions
#   $EDITOR config.env
#   ./scripts/render-sirius-yaml.sh

# --- Sirius checkout (must already contain pixi + TPC-H helpers) ---
SIRIUS_ROOT="${SIRIUS_ROOT:-$HOME/sirius}"

# --- Where parquet, spill files, telemetry, and logs live ---
DATA_ROOT="${DATA_ROOT:-$HOME/data/tpch}"

# --- Workload ---
SCALE_FACTORS="${SCALE_FACTORS:-100 200 300}"
PROBE_QUERIES="${PROBE_QUERIES:-1 6 9}"
PHASE1_ITERATIONS="${PHASE1_ITERATIONS:-1}"
PHASE3_ITERATIONS="${PHASE3_ITERATIONS:-2}"
FORCE_DISK_QUERY="${FORCE_DISK_QUERY:-9}"
FORCE_DISK_SF="${FORCE_DISK_SF:-300}"
# Host caps to try, largest first, until Quent task records show DISK.
FORCE_DISK_HOST_CAPS="${FORCE_DISK_HOST_CAPS:-40GiB 16GiB 8GiB}"

# --- Memory ladder written into sirius.yaml ---
# Number of visible GPUs Sirius should use. Set CUDA_VISIBLE_DEVICES in config.env.
NUM_GPUS="${NUM_GPUS:-1}"
# GPU: fraction of detected VRAM. Bytes form: GPU_USAGE_LIMIT=6GiB (unset fraction).
GPU_USAGE_LIMIT_FRACTION="${GPU_USAGE_LIMIT_FRACTION:-0.9}"
GPU_RESERVATION_LIMIT_FRACTION="${GPU_RESERVATION_LIMIT_FRACTION:-1.0}"
GPU_DOWNGRADE_TRIGGER_FRACTION="${GPU_DOWNGRADE_TRIGGER_FRACTION:-0.8}"
GPU_DOWNGRADE_STOP_FRACTION="${GPU_DOWNGRADE_STOP_FRACTION:-0.6}"

# Host pinned capacity. Absolute size, e.g. 8GiB / 40GiB / 128GiB.
HOST_CAPACITY="${HOST_CAPACITY:-8GiB}"
HOST_RESERVATION_LIMIT_FRACTION="${HOST_RESERVATION_LIMIT_FRACTION:-1.0}"
HOST_DOWNGRADE_TRIGGER_FRACTION="${HOST_DOWNGRADE_TRIGGER_FRACTION:-0.9}"
HOST_DOWNGRADE_STOP_FRACTION="${HOST_DOWNGRADE_STOP_FRACTION:-0.8}"
HOST_BLOCK_SIZE="${HOST_BLOCK_SIZE:-1MiB}"
HOST_POOL_SIZE="${HOST_POOL_SIZE:-128}"
HOST_INITIAL_NUMBER_POOLS="${HOST_INITIAL_NUMBER_POOLS:-4}"

# Disk spill. Directory is created under DATA_ROOT unless overridden.
DISK_CAPACITY="${DISK_CAPACITY:-200GiB}"
DISK_ID="${DISK_ID:-0}"

# Operator / executor knobs (laptop-safe defaults; raise on big GPUs)
PIPELINE_THREADS="${PIPELINE_THREADS:-4}"
DOWNGRADE_THREADS="${DOWNGRADE_THREADS:-1}"
TASK_CREATOR_THREADS="${TASK_CREATOR_THREADS:-2}"
SCAN_TASK_BATCH_SIZE="${SCAN_TASK_BATCH_SIZE:-768MiB}"
HASH_PARTITION_BYTES="${HASH_PARTITION_BYTES:-768MiB}"
CONCAT_BATCH_BYTES="${CONCAT_BATCH_BYTES:-768MiB}"
MAX_BUILD_HASH_TABLE_BYTES="${MAX_BUILD_HASH_TABLE_BYTES:-768MiB}"
MAX_SORT_PARTITION_BYTES="${MAX_SORT_PARTITION_BYTES:-0}"

# Quent
QUENT_EXPORTER="${QUENT_EXPORTER:-postcard}"
ENGINE_NAME="${ENGINE_NAME:-siriusDB}"
QUENT_PORT="${QUENT_PORT:-8080}"

# Build
# Leave empty to auto-detect from nvidia-smi (e.g. 8.9 -> 89-real).
CUDAARCHS="${CUDAARCHS:-}"
BUILD_NO_TESTS="${BUILD_NO_TESTS:-0}"
GENERATE_JOBS="${GENERATE_JOBS:-}"
